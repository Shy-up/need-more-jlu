{
  "manifest_version": 3,
  "name": "need_more_jlu - 吉大校园网实用增强",
  "version": "1.0.0",
  "description": "空闲教室查询，OA增强等小功能",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "need_more_jlu 控制面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "cookies",
    "declarativeNetRequest",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://oa.jlu.edu.cn/*",
    "*://vpn.jlu.edu.cn/*",
    "*://iedu.jlu.edu.cn/*",
    "*://*.jlu.edu.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://iedu.jlu.edu.cn/*",
        "*://vpn.jlu.edu.cn/*"
      ],
      "js": [
        "content/iedu_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://oa.jlu.edu.cn/*",
        "*://vpn.jlu.edu.cn/*defaultroot/*"
      ],
      "css": [
        "content/inject.css"
      ],
      "js": [
        "content/drawer.js",
        "content/inject.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard/*",
        "icons/*",
        "data/*",
        "assets/*",
        "config/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  }
}